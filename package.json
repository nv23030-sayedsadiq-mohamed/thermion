    "date-fns": "^4.1.0",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^5.6.0",
    "next": "16.4.3",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.0.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "5.7.3"
  }
