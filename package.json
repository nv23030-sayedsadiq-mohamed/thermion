{
  "name": "thermion",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "ingest": "tsx scripts/ingest.ts",
    "test:http": "node scripts/smoke-http.mjs",
    "format:check": "prettier --check \"components/platform/**/*.{ts,tsx}\" \"components/maps/*.tsx\" \"lib/{firms,harmonization,validation,analytics}/**/*.ts\" lib/i18n/platform.ts types/fire.ts scripts/ingest.ts \"tests/*.ts\""
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
